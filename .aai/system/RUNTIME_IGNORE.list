# AAI runtime-sidecar gitignore patterns — SINGLE SOURCE OF TRUTH.
# Consumed by: aai-bootstrap.sh ensure_gitignore (fresh installs) and
# aai-sync.sh's gitignore section (every update) — both via the shared
# .aai/scripts/lib/gitignore-block.sh reconcile — and aai-sync.ps1's
# PowerShell reconcile (fresh installs and updates on Windows). One pattern
# per line; '#' comments ignored; '!' negation lines keep the .gitkeep
# placeholders tracked.
docs/ai/STATE.yaml
docs/ai/LOOP_TICKS.jsonl
docs/ai/hitl-channel.json
docs/ai/briefs/**
!docs/ai/briefs/
!docs/ai/briefs/.gitkeep
docs/ai/reports/**
!docs/ai/reports/
!docs/ai/reports/.gitkeep
docs/ai/tdd/**
!docs/ai/tdd/
!docs/ai/tdd/.gitkeep
docs/ai/friction/**
!docs/ai/friction/
!docs/ai/friction/.gitkeep
docs/ai/archive/**
!docs/ai/archive/
!docs/ai/archive/.gitkeep
docs/ai/validation/**
!docs/ai/validation/
!docs/ai/validation/.gitkeep
docs/ai/loop/
docs/ai/locks/
docs/ai/.session-context.md
docs/ai/.pre-compact-state-backup.yaml
docs/INDEX.audit.md
docs/ai/live-status.html
docs/ai/live-status-data.json
docs/ai/live/**
