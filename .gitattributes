# Enforce LF for executable scripts across platforms.
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf

# Keep Windows command scripts in CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# ISSUE-0001 / SPEC-0007 — keep the docs corpus and the .mjs scripts that read it
# LF regardless of core.autocrlf, so parseFrontmatter never sees a CRLF checkout.
docs/**/*.md text eol=lf
.claude/skills/**/SKILL.md text eol=lf
.agents/skills/**/SKILL.md text eol=lf
.codex/skills/**/SKILL.md text eol=lf
.codex/skills/README.md text eol=lf
.gemini/skills/**/SKILL.md text eol=lf
.gemini/skills/README.md text eol=lf
*.mjs text eol=lf

# Binary assets. Declared, not inferred: tests/skills/lib/no-nul-guard.sh
# exempts a path from the no-NUL guard ONLY when it is declared binary here,
# because git considers any file with a NUL byte binary and inferring the
# exemption would empty the guard it exempts from.
*.png binary
